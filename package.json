{
  "name": "task-workspaces",
  "displayName": "Task Workspaces",
  "description": "Manage isolated development tasks using Git worktrees and coding agents.",
  "version": "0.16.3",
  "publisher": "task-workspaces",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ConorWatson95/vscode-workgrid.git"
  },
  "bugs": {
    "url": "https://github.com/ConorWatson95/vscode-workgrid/issues"
  },
  "homepage": "https://github.com/ConorWatson95/vscode-workgrid#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.git"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "taskWorkspaces",
          "title": "Task Workspaces",
          "icon": "$(list-tree)"
        }
      ]
    },
    "views": {
      "taskWorkspaces": [
        {
          "id": "taskWorkspaces.tree",
          "name": "Task Workspaces",
          "icon": "$(list-tree)"
        },
        {
          "id": "taskWorkspaces.detail",
          "name": "Details",
          "type": "webview"
        },
        {
          "id": "taskWorkspaces.usage",
          "name": "Plan Usage",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "taskWorkspaces.create",
        "title": "Create Task Workspace",
        "category": "Task Workspaces",
        "icon": "$(add)"
      },
      {
        "command": "taskWorkspaces.refresh",
        "title": "Refresh",
        "category": "Task Workspaces",
        "icon": "$(refresh)"
      },
      {
        "command": "taskWorkspaces.sessionHistory",
        "title": "Session History…",
        "category": "Task Workspaces",
        "icon": "$(history)"
      },
      {
        "command": "taskWorkspaces.open",
        "title": "Open Workspace",
        "category": "Task Workspaces",
        "icon": "$(folder-opened)"
      },
      {
        "command": "taskWorkspaces.detail",
        "title": "Task Details",
        "category": "Task Workspaces",
        "icon": "$(info)"
      },
      {
        "command": "taskWorkspaces.openInVisualStudio",
        "title": "Open in Visual Studio",
        "category": "Task Workspaces",
        "icon": "$(vm)"
      },
      {
        "command": "taskWorkspaces.revealInExplorer",
        "title": "Reveal in File Explorer",
        "category": "Task Workspaces",
        "icon": "$(folder-opened)"
      },
      {
        "command": "taskWorkspaces.showDiff",
        "title": "Show Git Diff",
        "category": "Task Workspaces",
        "icon": "$(diff)"
      },
      {
        "command": "taskWorkspaces.requiredReviews",
        "title": "Show Required Reviews",
        "category": "Task Workspaces",
        "icon": "$(checklist)"
      },
      {
        "command": "taskWorkspaces.createReviewRules",
        "title": "Create Harness Config (routes + review rules)",
        "category": "Task Workspaces"
      },
      {
        "command": "taskWorkspaces.advanceRoute",
        "title": "Advance Route",
        "category": "Task Workspaces",
        "icon": "$(debug-continue)"
      },
      {
        "command": "taskWorkspaces.approveStage",
        "title": "Approve Stage",
        "category": "Task Workspaces",
        "icon": "$(check)"
      },
      {
        "command": "taskWorkspaces.toggleChecklistItem",
        "title": "Toggle Verified",
        "category": "Task Workspaces",
        "icon": "$(check)"
      },
      {
        "command": "taskWorkspaces.copyPath",
        "title": "Copy Path",
        "category": "Task Workspaces"
      },
      {
        "command": "taskWorkspaces.archive",
        "title": "Archive Task (hide)",
        "category": "Task Workspaces",
        "icon": "$(archive)"
      },
      {
        "command": "taskWorkspaces.unarchive",
        "title": "Restore Task",
        "category": "Task Workspaces",
        "icon": "$(history)"
      },
      {
        "command": "taskWorkspaces.toggleArchived",
        "title": "Show/Hide Archived Tasks",
        "category": "Task Workspaces",
        "icon": "$(eye)"
      },
      {
        "command": "taskWorkspaces.remove",
        "title": "Remove Workspace",
        "category": "Task Workspaces",
        "icon": "$(trash)"
      },
      {
        "command": "taskWorkspaces.adopt",
        "title": "Adopt Worktree as Task",
        "category": "Task Workspaces",
        "icon": "$(add)"
      },
      {
        "command": "taskWorkspaces.removeOrphan",
        "title": "Remove Untracked Worktree",
        "category": "Task Workspaces",
        "icon": "$(trash)"
      },
      {
        "command": "taskWorkspaces.openChat",
        "title": "Open Chat",
        "category": "Task Workspaces",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "taskWorkspaces.startAgent",
        "title": "Start Agent (default mode)",
        "category": "Task Workspaces",
        "icon": "$(play)"
      },
      {
        "command": "taskWorkspaces.startNative",
        "title": "Start in Claude Extension (new window)",
        "category": "Task Workspaces",
        "icon": "$(window)"
      },
      {
        "command": "taskWorkspaces.startChat",
        "title": "Start in Chat Panel",
        "category": "Task Workspaces",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "taskWorkspaces.startTerminal",
        "title": "Start in Terminal",
        "category": "Task Workspaces",
        "icon": "$(terminal)"
      },
      {
        "command": "taskWorkspaces.stopAgent",
        "title": "Stop Agent",
        "category": "Task Workspaces",
        "icon": "$(debug-stop)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "taskWorkspaces.create",
          "when": "view == taskWorkspaces.tree",
          "group": "navigation@1"
        },
        {
          "command": "taskWorkspaces.refresh",
          "when": "view == taskWorkspaces.tree",
          "group": "navigation@2"
        },
        {
          "command": "taskWorkspaces.toggleArchived",
          "when": "view == taskWorkspaces.tree",
          "group": "navigation@3"
        },
        {
          "command": "taskWorkspaces.sessionHistory",
          "when": "view == taskWorkspaces.tree",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "taskWorkspaces.advanceRoute",
          "when": "view == taskWorkspaces.tree && viewItem =~ /harnessed/",
          "group": "inline@1"
        },
        {
          "command": "taskWorkspaces.startChat",
          "when": "view == taskWorkspaces.tree && viewItem =~ /adhoc/",
          "group": "inline@1"
        },
        {
          "command": "taskWorkspaces.startNative",
          "when": "view == taskWorkspaces.tree && viewItem =~ /adhoc/",
          "group": "inline@2"
        },
        {
          "command": "taskWorkspaces.startTerminal",
          "when": "view == taskWorkspaces.tree && viewItem =~ /adhoc/",
          "group": "inline@3"
        },
        {
          "command": "taskWorkspaces.startChat",
          "when": "view == taskWorkspaces.tree && viewItem =~ /harnessed/",
          "group": "2_agent@1"
        },
        {
          "command": "taskWorkspaces.startNative",
          "when": "view == taskWorkspaces.tree && viewItem =~ /harnessed/",
          "group": "2_agent@2"
        },
        {
          "command": "taskWorkspaces.startTerminal",
          "when": "view == taskWorkspaces.tree && viewItem =~ /harnessed/",
          "group": "2_agent@3"
        },
        {
          "command": "taskWorkspaces.adopt",
          "when": "view == taskWorkspaces.tree && viewItem == orphan",
          "group": "inline@1"
        },
        {
          "command": "taskWorkspaces.removeOrphan",
          "when": "view == taskWorkspaces.tree && viewItem == orphan",
          "group": "inline@2"
        },
        {
          "command": "taskWorkspaces.adopt",
          "when": "view == taskWorkspaces.tree && viewItem == orphan",
          "group": "1_open@1"
        },
        {
          "command": "taskWorkspaces.removeOrphan",
          "when": "view == taskWorkspaces.tree && viewItem == orphan",
          "group": "9_danger@1"
        },
        {
          "command": "taskWorkspaces.detail",
          "when": "view == taskWorkspaces.tree && viewItem =~ /task/",
          "group": "1_open@1"
        },
        {
          "command": "taskWorkspaces.showDiff",
          "when": "view == taskWorkspaces.tree && viewItem =~ /task/",
          "group": "1_open@3"
        },
        {
          "command": "taskWorkspaces.requiredReviews",
          "when": "view == taskWorkspaces.tree && viewItem =~ /task/",
          "group": "1_open@4"
        },
        {
          "command": "taskWorkspaces.advanceRoute",
          "when": "view == taskWorkspaces.tree && viewItem =~ /task/",
          "group": "1_open@5"
        },
        {
          "command": "taskWorkspaces.approveStage",
          "when": "view == taskWorkspaces.tree && viewItem == stage-awaiting-approval",
          "group": "inline"
        },
        {
          "command": "taskWorkspaces.toggleChecklistItem",
          "when": "view == taskWorkspaces.tree && viewItem =~ /^checklist-/",
          "group": "inline"
        },
        {
          "command": "taskWorkspaces.copyPath",
          "when": "view == taskWorkspaces.tree && viewItem =~ /task/",
          "group": "1_open@3"
        },
        {
          "command": "taskWorkspaces.revealInExplorer",
          "when": "view == taskWorkspaces.tree && viewItem =~ /task/",
          "group": "1_open@4"
        },
        {
          "command": "taskWorkspaces.openInVisualStudio",
          "when": "view == taskWorkspaces.tree && viewItem =~ /task/",
          "group": "1_open@5"
        },
        {
          "command": "taskWorkspaces.startNative",
          "when": "view == taskWorkspaces.tree && viewItem =~ /task/",
          "group": "2_agent@1"
        },
        {
          "command": "taskWorkspaces.startChat",
          "when": "view == taskWorkspaces.tree && viewItem =~ /task/",
          "group": "2_agent@2"
        },
        {
          "command": "taskWorkspaces.startTerminal",
          "when": "view == taskWorkspaces.tree && viewItem =~ /task/",
          "group": "2_agent@3"
        },
        {
          "command": "taskWorkspaces.stopAgent",
          "when": "view == taskWorkspaces.tree && viewItem =~ /task/",
          "group": "2_agent@4"
        },
        {
          "command": "taskWorkspaces.archive",
          "when": "view == taskWorkspaces.tree && viewItem =~ /archivable/",
          "group": "3_lifecycle@1"
        },
        {
          "command": "taskWorkspaces.unarchive",
          "when": "view == taskWorkspaces.tree && viewItem =~ /archived/",
          "group": "3_lifecycle@1"
        },
        {
          "command": "taskWorkspaces.remove",
          "when": "view == taskWorkspaces.tree && viewItem =~ /task/",
          "group": "3_lifecycle@2"
        }
      ]
    },
    "configuration": {
      "title": "Task Workspaces",
      "properties": {
        "taskWorkspaces.worktreeParentDir": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Directory in which new worktrees are created. If empty, worktrees are created as siblings of the repository (`<repoParent>/<repoName>-<slug>`). Supports absolute paths."
        },
        "taskWorkspaces.branchPrefixes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "feature",
            "bug",
            "fix",
            "perf",
            "refactor",
            "chore"
          ],
          "scope": "resource",
          "description": "Allowed branch type prefixes offered when creating a task workspace."
        },
        "taskWorkspaces.defaultBaseBranch": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Default base branch for new worktrees. If empty, the repository's current HEAD branch is used."
        },
        "taskWorkspaces.copyIntoWorktree": {
          "type": "array",
          "default": [],
          "scope": "resource",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "description": "Path relative to the repository root, copied to the same relative path in the new worktree."
              },
              {
                "type": "object",
                "required": [
                  "from"
                ],
                "additionalProperties": false,
                "properties": {
                  "from": {
                    "type": "string",
                    "description": "Source path. Relative to the repository root, or absolute."
                  },
                  "to": {
                    "type": "string",
                    "description": "Destination, relative to the new worktree. Required when 'from' is absolute."
                  }
                }
              }
            ]
          },
          "markdownDescription": "Files and directories copied into each new worktree after it is created. A fresh worktree contains only tracked files, so untracked local config (for example `.claude/settings.local.json`) has to be brought across.\n\nEntries are either a repository-relative path — copied to the same relative path — or `{ \"from\": \"...\", \"to\": \"...\" }` where `to` is relative to the worktree. Destinations that escape the worktree are refused. A missing source is logged and skipped, never fatal.\n\nExample: `[\".claude/settings.local.json\", { \"from\": \"C:/shared/.env.local\", \"to\": \".env.local\" }]`"
        },
        "taskWorkspaces.harnessConfigPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Location of this project's harness config: the **routes** work travels through and the **review rules** a change obliges. Relative to the repository root, or absolute to share one config across repositories. Defaults to `.taskworkspaces/harness.json`, falling back to `.taskworkspaces/review-rules.json`.\n\nAlways read from the repository root, never from a task worktree, so a branch cannot relax its own review requirements. Create one with **Task Workspaces: Create Harness Config**."
        },
        "taskWorkspaces.reviewRulesPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "**Deprecated** — use `#taskWorkspaces.harnessConfigPath#`, which covers routes as well as rules. Still honoured when set and the newer setting is empty."
        },
        "taskWorkspaces.claudeCommand": {
          "type": "string",
          "default": "claude",
          "scope": "machine-overridable",
          "description": "Command used to launch the Claude Code CLI."
        },
        "taskWorkspaces.agentMode": {
          "type": "string",
          "enum": [
            "native",
            "chat",
            "terminal"
          ],
          "enumDescriptions": [
            "Open the task's worktree in a new window and launch Claude Code's own chat UI (requires the anthropic.claude-code extension).",
            "Run Claude headless and show a built-in chat panel inside this window.",
            "Run Claude in an integrated terminal."
          ],
          "default": "native",
          "scope": "resource",
          "description": "How to start Claude for a task. 'native' uses the official Claude Code extension's chat in the worktree window; 'chat' uses the built-in panel; 'terminal' uses an integrated terminal."
        },
        "taskWorkspaces.trackNativeActivity": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "Show best-effort live activity (working / awaiting input) for **native**-mode tasks by watching Claude Code's session transcripts. This reads an undocumented on-disk layout and may lag or miss; disable to only track built-in chat sessions."
        },
        "taskWorkspaces.compactPromptThreshold": {
          "type": "number",
          "default": 120000,
          "scope": "resource",
          "markdownDescription": "When a chat session's context grows beyond this many tokens, the panel prompts you to compact it. Set to `0` to disable the prompt."
        },
        "taskWorkspaces.autoCompactThreshold": {
          "type": "number",
          "default": 0,
          "scope": "resource",
          "markdownDescription": "When a chat session's context grows beyond this many tokens, `#taskWorkspaces.contextStrategy#` is applied automatically at the end of the current turn (no prompt). Set to `0` to disable. Recommended to set this higher than `#taskWorkspaces.compactPromptThreshold#` so you are warned first and only acted on if you keep going — e.g. `160000`."
        },
        "taskWorkspaces.mcpConfigPath": {
          "type": "string",
          "default": ".mcp.json",
          "scope": "resource",
          "markdownDescription": "MCP server config loaded explicitly into every agent session, via the CLI's `--mcp-config`. Relative to the repository root, or absolute. Set to empty to disable.\n\nEach task worktree is a directory the CLI has never seen, so a project-scoped `.mcp.json` inside it is unapproved — `enabledMcpjsonServers` stays empty and none of its servers start. Non-interactive sessions skip the trust *dialog*, which is not the same as granting trust, and a route's headless sessions have nobody to answer a prompt. Passing the config explicitly is what actually loads the servers.\n\nRead from the **repository root**, never a task worktree, so a branch cannot grant itself new tool access. Existing user-scope MCP servers are unaffected (`--strict-mcp-config` is not used)."
        },
        "taskWorkspaces.stageTimeoutMinutes": {
          "type": "number",
          "default": 45,
          "scope": "resource",
          "markdownDescription": "Hard stop for a single route subtask, so a hung CLI cannot stall a route forever. A stage that hits this is recorded as **failed**, so prefer a generous value: planning or investigation stages on a large repository legitimately take tens of minutes, and per-process overhead on the machine (on-access virus scanning of every process launch, most often) multiplies that. Whatever the stage produced before the cap is kept in the log."
        },
        "taskWorkspaces.contextStrategy": {
          "type": "string",
          "enum": [
            "compact",
            "checkpoint"
          ],
          "enumDescriptions": [
            "Run /compact: summarise the conversation in place and continue in the same session.",
            "Ask the agent for a written handoff, then continue in a fresh session briefed from it."
          ],
          "default": "compact",
          "scope": "resource",
          "markdownDescription": "What to do when a session crosses `#taskWorkspaces.autoCompactThreshold#`. `compact` summarises in place, so context regrows from the summary. `checkpoint` writes a handoff (decisions, remaining work, next step), starts a fresh session from it, and keeps the carried-forward brief size-capped — slower to trigger, but context does not accumulate across the whole task."
        },
        "taskWorkspaces.model": {
          "type": "string",
          "examples": [
            "",
            "fable",
            "opus",
            "sonnet",
            "haiku"
          ],
          "default": "",
          "scope": "resource",
          "markdownDescription": "Model for chat-panel sessions, passed to the CLI's `--model`. These are family aliases — each resolves to the *latest* model in that family, so they stay current as new versions ship. Empty uses the CLI default. You can also set a specific model id (e.g. `claude-opus-5`) by editing this value directly, or switch per-session from the chat panel header."
        },
        "taskWorkspaces.permissionMode": {
          "type": "string",
          "enum": [
            "default",
            "acceptEdits",
            "plan",
            "bypassPermissions"
          ],
          "enumDescriptions": [
            "Prompt according to your normal Claude settings.",
            "Auto-accept file edits; prompt for other actions.",
            "Planning only — no changes are made.",
            "Skip all permission checks (use with care)."
          ],
          "default": "acceptEdits",
          "scope": "resource",
          "markdownDescription": "Permission mode for chat-panel sessions. Because the headless panel cannot yet show interactive per-action prompts, `acceptEdits` or `plan` are recommended."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepackage": "node -e \"const fs=require('fs');for(const f of fs.readdirSync('.'))if(f.endsWith('.vsix'))fs.unlinkSync(f)\"",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^2.29.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
